{
  "name": "svastaonica",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "cms": "npx --yes decap-server",
    "cms:index": "node scripts/generate-cms-product-index.mjs",
    "cjenik": "node scripts/generate-cjenik.mjs",
    "backup:products": "node scripts/backup-products.mjs",
    "dev:cms": "npm run cms:index && npx --yes concurrently -k -n web,cms -c magenta,cyan \"npm run dev\" \"npm run cms\"",
    "prebuild": "npm run cms:index && npm run cjenik"
  },
  "dependencies": {
    "v-lazy-image": "^2.1.1",
    "vue": "^3.2.38",
    "vue-router": "^4.1.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^3.0.3",
    "vite": "^3.0.9"
  }
}
